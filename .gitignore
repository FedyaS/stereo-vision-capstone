# What is and is not committed.
#
# The rule: anything a command can regenerate stays out; anything a human
# wrote, or deliberately chose to keep, goes in. See docs/repository.md.
#
# To commit a file that lands in an ignored directory, put it under
# `results/keep/` -- that path is un-ignored, so plain `git add` works and
# no `git add -f` is needed. `python scripts/keep_result.py <run>` copies a
# run's small files there for you.

# ---------------------------------------------------------------------------
# Generated: benchmark output
# ---------------------------------------------------------------------------
# `results/*` rather than `results/` on purpose: git does not descend into an
# ignored *directory*, so `results/` would make the un-ignore below dead.
results/*
!results/keep/

# ---------------------------------------------------------------------------
# Generated: downloaded inputs  (scripts/get_dataset.py, scripts/get_models.py)
# ---------------------------------------------------------------------------
data/*
!data/README.md
models/*
!models/README.md

# ---------------------------------------------------------------------------
# Generated: Python
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# Generated: Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Generated: web frontend  (npm install / npm run build)
# ---------------------------------------------------------------------------
app/web/node_modules/
app/web/dist/
app/web/*.tsbuildinfo

# ---------------------------------------------------------------------------
# Generated: LaTeX build products
# ---------------------------------------------------------------------------
# Scoped to the presentation rather than repo-wide: a bare `*.log` or `*.out`
# would silently swallow an output file somebody meant to commit.
docs/presentation/*.aux
docs/presentation/*.bbl
docs/presentation/*.blg
docs/presentation/*.fdb_latexmk
docs/presentation/*.fls
docs/presentation/*.log
docs/presentation/*.nav
docs/presentation/*.out
docs/presentation/*.snm
docs/presentation/*.synctex.gz
docs/presentation/*.toc
docs/presentation/*.vrb

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
Thumbs.db
.DS_Store
*.swp
